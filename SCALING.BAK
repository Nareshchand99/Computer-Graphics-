  draw();
  //doing translation
  scal();
  setcolor(YELLOW);
  draw();
  getch();
}

void draw()
{
  for(i=0; i<n; i++)
   line(x[i],y[i],x[(i+1)%n],y[(i+1)%n]);
}

void scal()
